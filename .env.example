# SmartGen server environment variables.
# Copy this file to .env and adjust as needed.
# Do NOT commit .env to version control.

# ── STT backend ────────────────────────────────────────────────────────────────
# sherpa     (default) — Zipformer 30M, streaming, 80-150ms/word
# dual       — Zipformer 30M real-time display + Whisper verify pass
# whisper    — faster-whisper only (EraX-WoW-Turbo or CT2 model)
# phowhisper — highest accuracy dual pipeline (~3s latency)
STT_BACKEND=sherpa

# ── NLLB translation engine device (production default: CPU) ───────────────────
# NLLB-200 on CPU (int8) avoids CUDA contention with PhoWhisper on the GPU —
# measured fix for slow translation in Studio mode. run.ps1 sets these defaults
# automatically if unset; override here only to change them.
# NLLB_DEVICE=cpu
# NLLB_INTRA_THREADS=6

# ── TTS ONNX execution provider ────────────────────────────────────────────────
# CPUExecutionProvider  (default, safe) — ~517ms first chunk
# CUDAExecutionProvider — ~80-150ms first chunk (requires cuDNN 9 for CUDA 12.x)
ONNX_PROVIDER=CPUExecutionProvider

# ── STT model override (sherpa/dual backends) ──────────────────────────────────
# Leave blank to use the default Zipformer 30M model.
# STT_MODEL=sherpa-onnx-zipformer-vi-30M-int8-2026-02-09

# ── Debug WebSocket message logging ───────────────────────────────────────────
# Set to "1" to print every WS frame type to the server console.
DEBUG_WS=0
